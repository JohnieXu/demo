{
  "name": "tsconfig-paths",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:tscalias:cjs": "tsc -p tsconfig.tsalias-cjs.json && tsc-alias -p tsconfig.tsalias-cjs.json",
    "build:tscalias:esm": "tsc -p tsconfig.tsalias-esm.json && tsc-alias -p tsconfig.tsalias-esm.json",
    "start": "node pages/home.js",
    "start:esm": "node --experimental-specifier-resolution=node pages/home.mjs",
    "start-with-paths": "node -r tsconfig-paths/register pages/home.js",
    "start-with-alias": "node -r module-alias/register pages/home.js",
    "start-with-tscalias-cjs": "node dist/pages/home.js",
    "start-with-tscalias-esm": "node dist/pages/home.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "module-alias": "^2.2.3",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.1"
  },
  "_moduleAliases": {
    "@@root": ".",
    "@@utils": "utils"
  },
  "_moduleDirectories": [
    "node_modules_custom"
  ]
}