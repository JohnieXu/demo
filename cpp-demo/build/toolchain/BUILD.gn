import("gcc_toolchain.gni")

if (host_os == "mac") {
  _default_cc = "cc"
  _default_cxx = "c++"
  _default_ld = "c++"
  _default_ar = "ar"
  _default_os = "mac"
} else {
  _default_cc = "gcc"
  _default_cxx = "g++"
  _default_ld = "g++"
  _default_ar = "ar"
  _default_os = "linux"
}

gcc_toolchain("gcc") {
  cc = _default_cc
  cxx = _default_cxx
  ld = _default_ld
  ar = _default_ar
  current_cpu = host_cpu
  current_os = _default_os
}
